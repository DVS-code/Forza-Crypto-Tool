<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BgColor">#0E0F12</Color>
    <Color x:Key="SurfaceColor">#16181D</Color>
    <Color x:Key="RaisedColor">#1D2027</Color>
    <Color x:Key="OverlayColor">#252932</Color>
    <Color x:Key="BorderColor">#2C313B</Color>
    <Color x:Key="BorderStrongColor">#3A4150</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="Overlay" Color="{StaticResource OverlayColor}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}" />

    <Color x:Key="TextPrimaryColor">#F4F6FA</Color>
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A7B0C0" />
    <SolidColorBrush x:Key="TextDisabled" Color="#5C6575" />

    <Color x:Key="AccentColor">#2E8FFF</Color>
    <Color x:Key="AccentHoverColor">#57A6FF</Color>
    <Color x:Key="AccentPressColor">#1B77E0</Color>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPress" Color="{StaticResource AccentPressColor}" />

    <SolidColorBrush x:Key="AccentDim" Color="#12283F" />

    <SolidColorBrush x:Key="Success" Color="#3DD68C" />
    <SolidColorBrush x:Key="SuccessDim" Color="#14301F" />
    <SolidColorBrush x:Key="Warning" Color="#FFC53D" />
    <SolidColorBrush x:Key="WarningDim" Color="#332A10" />
    <SolidColorBrush x:Key="Danger" Color="#FF5C5C" />
    <SolidColorBrush x:Key="DangerDim" Color="#331A1A" />
    <SolidColorBrush x:Key="Info" Color="#4DA3FF" />
    <SolidColorBrush x:Key="InfoDim" Color="#14243A" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <system:Double x:Key="FontDisplay" xmlns:system="clr-namespace:System;assembly=mscorlib">26</system:Double>
    <system:Double x:Key="FontTitle" xmlns:system="clr-namespace:System;assembly=mscorlib">19</system:Double>
    <system:Double x:Key="FontHeading" xmlns:system="clr-namespace:System;assembly=mscorlib">15</system:Double>
    <system:Double x:Key="FontBody" xmlns:system="clr-namespace:System;assembly=mscorlib">13.5</system:Double>
    <system:Double x:Key="FontSmall" xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
    <system:Double x:Key="FontTiny" xmlns:system="clr-namespace:System;assembly=mscorlib">11</system:Double>

    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>

</ResourceDictionary>
