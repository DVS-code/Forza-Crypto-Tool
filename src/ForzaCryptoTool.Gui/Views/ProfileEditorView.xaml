<UserControl x:Class="ForzaCryptoTool.ProfileEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True">
    <UserControl.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Margin="0,0,3,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentDim}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource Raised}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                    <Setter Property="Background" Value="{StaticResource Raised}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Border}" />
            <Setter Property="RowBackground" Value="{StaticResource Surface}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource Raised}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="ColumnHeaderHeight" Value="36" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentDim}" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Overlay}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentDim}" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource Bg}" Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="FH6 Profile Editor" Style="{StaticResource TitleText}" />
                <TextBlock Text="Open encrypted or decrypted FH6 ProfileData, edit safely, and export a verified copy" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="Open or decrypt" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnOpenClick" />
                <Button x:Name="SaveButton" Content="Save edited copy" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="OnSaveClick" />
            </WrapPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="FileNameText" Text="Drop or open an FH6 C_ProfileData file" Style="{StaticResource HeadingText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="FileSummaryText" Text="Drop encrypted C_ProfileData here, or open a decrypted .bin. FH5 schemas are rejected." Style="{StaticResource SmallText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="WorkflowText" Text="ENCRYPTED OR DECRYPTED INPUT  >  EDIT  >  VERIFIED OUTPUT" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold" Margin="0,7,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource AccentDim}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock x:Name="DirtyText" Text="NO FILE" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="11" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <TextBlock x:Name="EmptyText" Text="DROP AN FH6 PROFILE HERE&#x0a;&#x0a;Encrypted C_ProfileData files are decrypted temporarily, edited, verified, and re-encrypted when you save.&#x0a;Decrypted .bin files can also be opened directly."
                           Style="{StaticResource SecondaryText}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TabControl x:Name="EditorTabs" SelectedIndex="0" Visibility="Collapsed" Background="{StaticResource Surface}" BorderThickness="0">
                    <TabItem Header="Overview">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Profile health" Style="{StaticResource HeadingText}" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock Text="PROPERTIES" Style="{StaticResource LabelText}"/><TextBlock x:Name="OverviewProperties" Style="{StaticResource HeadingText}" Margin="0,4,0,0"/></StackPanel></Border>
                                    <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock Text="BXML NODES" Style="{StaticResource LabelText}"/><TextBlock x:Name="OverviewBxml" Style="{StaticResource HeadingText}" Margin="0,4,0,0"/></StackPanel></Border>
                                    <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock Text="BINARY RECORDS" Style="{StaticResource LabelText}"/><TextBlock x:Name="OverviewBinary" Style="{StaticResource HeadingText}" Margin="0,4,0,0"/></StackPanel></Border>
                                    <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock Text="SQLITE" Style="{StaticResource LabelText}"/><TextBlock x:Name="OverviewSqlite" Style="{StaticResource HeadingText}" Margin="0,4,0,0"/></StackPanel></Border>
                                </WrapPanel>
                                <TextBlock Text="Account XUID" Style="{StaticResource HeadingText}" Margin="0,18,0,8" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="XuidText" Style="{StaticResource MonoField}" />
                                    <Button Grid.Column="1" Content="Apply XUID" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="OnApplyXuid" />
                                </Grid>
                                <TextBlock Text="This edits the canonical BinaryCareer XUID only. Decimal and 0x-prefixed hex are accepted." Style="{StaticResource SmallText}" Margin="0,6,0,0" />
                                <TextBlock Text="Sections" Style="{StaticResource HeadingText}" Margin="0,22,0,8" />
                                <DataGrid x:Name="SectionsGrid" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Index, Mode=OneWay}" Width="50"/>
                                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind, Mode=OneWay}" Width="*"/>
                                        <DataGridTextColumn Header="Marker" Binding="{Binding Marker, Mode=OneWay}" Width="120"/>
                                        <DataGridTextColumn Header="Bytes" Binding="{Binding Size, Mode=OneWay, StringFormat=N0}" Width="120"/>
                                        <DataGridTextColumn Header="Offset" Binding="{Binding OffsetHex, Mode=OneWay}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Properties">
                        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="SEARCH PROPERTIES" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                <TextBox x:Name="PropertySearch" Grid.Column="1" Style="{StaticResource Field}" Height="38" ToolTip="Search path, type, or value" TextChanged="OnPropertySearchChanged" />
                            </Grid>
                            <DataGrid x:Name="PropertiesGrid" Grid.Row="1" Margin="0,10,0,10" SelectionChanged="OnPropertySelected">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Path" Binding="{Binding Path, Mode=OneWay}" Width="2*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type, Mode=OneWay}" Width="150"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value, Mode=OneWay}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="Editable" Binding="{Binding Editable, Mode=OneWay}" Width="75"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="SelectedPropertyText" Text="Select an editable property" Style="{StaticResource SmallText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBox x:Name="PropertyValueText" Grid.Column="1" Style="{StaticResource MonoField}" Margin="10,0" IsEnabled="False" />
                                <Button x:Name="ApplyPropertyButton" Grid.Column="2" Content="Apply" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="OnApplyProperty" />
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Binary records">
                        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="SEARCH RECORDS" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                <TextBox x:Name="BinarySearch" Grid.Column="1" Style="{StaticResource Field}" Height="38" ToolTip="Search record or serializer" TextChanged="OnBinarySearchChanged" />
                            </Grid>
                            <DataGrid x:Name="BinaryGrid" Grid.Row="1" Margin="0,10" SelectionChanged="OnBinarySelected">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Ordinal, Mode=OneWay}" Width="55"/>
                                    <DataGridTextColumn Header="Record" Binding="{Binding Name, Mode=OneWay}" Width="2*"/>
                                    <DataGridTextColumn Header="Serializer" Binding="{Binding Serializer, Mode=OneWay}" Width="2*"/>
                                    <DataGridTextColumn Header="Tag" Binding="{Binding Tag, Mode=OneWay}" Width="110"/>
                                    <DataGridTextColumn Header="Bytes" Binding="{Binding Size, Mode=OneWay, StringFormat=N0}" Width="100"/>
                                    <DataGridTextColumn Header="Payload offset" Binding="{Binding OffsetHex, Mode=OneWay}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2">
                                <TextBlock x:Name="BinarySelectionText" Text="Select a record to inspect or patch a fixed-width scalar." Style="{StaticResource SmallText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="BinaryHexText" Style="{StaticResource MonoText}" Margin="0,6" TextWrapping="Wrap" MaxHeight="54" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="BinaryOffsetText" Style="{StaticResource MonoField}" Text="0" ToolTip="Byte offset within the selected record payload" />
                                    <ComboBox x:Name="BinaryTypeCombo" Grid.Column="1" Margin="8,0" SelectedIndex="4" ItemsSource="{Binding BinaryScalarTypes}" />
                                    <TextBox x:Name="BinaryValueText" Grid.Column="2" Style="{StaticResource MonoField}" />
                                    <Button Grid.Column="3" Content="Read" Style="{StaticResource GhostButton}" Margin="8,0" Click="OnReadBinaryScalar" />
                                    <Button Grid.Column="4" Content="Apply scalar" Style="{StaticResource SecondaryButton}" Click="OnApplyBinaryScalar" />
                                </Grid>
                                <TextBlock Text="Advanced: offsets are relative to the payload. Edits keep the original width and are framing-validated; use only known FH6 fields." Style="{StaticResource SmallText}" Margin="0,5,0,0" Foreground="{StaticResource Warning}" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="BXML">
                        <TabControl Margin="10" Background="{StaticResource Surface}" BorderThickness="0">
                            <TabItem Header="Strings">
                                <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="Editing a string updates every BXML node that references it." Style="{StaticResource SmallText}" />
                                    <DataGrid x:Name="BxmlGrid" Grid.Row="1" Margin="0,10" SelectionChanged="OnBxmlStringSelected">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Index" Binding="{Binding Index, Mode=OneWay}" Width="80"/>
                                            <DataGridTextColumn Header="Value" Binding="{Binding Value, Mode=OneWay}" Width="*"/>
                                            <DataGridTextColumn Header="References" Binding="{Binding References, Mode=OneWay}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="BxmlValueText" Style="{StaticResource MonoField}" IsEnabled="False" />
                                        <Button x:Name="ApplyBxmlButton" Grid.Column="1" Content="Update string" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" IsEnabled="False" Click="OnApplyBxmlString" />
                                    </Grid>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Nodes">
                                <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Document flag" Style="{StaticResource SmallText}" VerticalAlignment="Center" />
                                        <TextBox x:Name="BxmlDocumentFlagText" Grid.Column="1" Style="{StaticResource MonoField}" Margin="8,0" />
                                        <Button Grid.Column="2" Content="Apply" Style="{StaticResource GhostButton}" Click="OnApplyBxmlDocumentFlag" />
                                    </Grid>
                                    <DataGrid x:Name="BxmlNodesGrid" Grid.Row="1" Margin="0,10" SelectionChanged="OnBxmlNodeSelected">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Offset" Binding="{Binding OffsetHex, Mode=OneWay}" Width="90"/>
                                            <DataGridTextColumn Header="Node" Binding="{Binding DisplayName, Mode=OneWay}" Width="2*"/>
                                            <DataGridTextColumn Header="Flags" Binding="{Binding FlagsHex, Mode=OneWay}" Width="70"/>
                                            <DataGridTextColumn Header="Attributes" Binding="{Binding Attributes, Mode=OneWay}" Width="3*"/>
                                            <DataGridTextColumn Header="Children" Binding="{Binding Children, Mode=OneWay}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="BxmlNodeNameText" Style="{StaticResource MonoField}" IsEnabled="False" ToolTip="Node name" />
                                        <TextBox x:Name="BxmlNodeFlagsText" Grid.Column="1" Style="{StaticResource MonoField}" Margin="8,0" IsEnabled="False" ToolTip="Flags (0..7 or hex)" />
                                        <Button x:Name="ApplyBxmlNodeButton" Grid.Column="2" Content="Update node" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="OnApplyBxmlNode" />
                                    </Grid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </TabItem>

                    <TabItem Header="Database">
                        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="TableCombo" SelectionChanged="OnTableSelected">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display, Mode=OneWay}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Content="Refresh" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="OnRefreshTable" />
                            </Grid>
                            <DataGrid x:Name="DatabaseGrid" Grid.Row="1" Margin="0,10" AutoGenerateColumns="True" />
                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="SqlText" Style="{StaticResource MonoField}" AcceptsReturn="True" MinHeight="64" Text="SELECT name, type FROM sqlite_master ORDER BY type, name;" />
                                <Button Grid.Column="1" Content="Run SQL" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" VerticalAlignment="Bottom" Click="OnRunSql" />
                            </Grid>
                            <TextBlock x:Name="SqlResultText" Grid.Row="3" Style="{StaticResource SmallText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </Grid>
                    </TabItem>

                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
