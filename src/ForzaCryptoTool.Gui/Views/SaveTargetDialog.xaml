<Window x:Class="ForzaCryptoTool.SaveTargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save changes"
        SizeToContent="Height"
        Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeadingText" Style="{StaticResource HeadingText}" Text="Where should this go?" />
            <TextBlock x:Name="SubjectText" Style="{StaticResource SmallText}" Margin="0,6,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12" Margin="0,16,0,0">
            <StackPanel>
                <RadioButton x:Name="OutputFolderOption" Style="{StaticResource Check}"
                             GroupName="Target" IsChecked="True">
                    <StackPanel>
                        <TextBlock Text="Save to the output folder" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock x:Name="OutputPathText" Style="{StaticResource SmallText}"
                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="OverwriteOption" Style="{StaticResource Check}"
                             GroupName="Target" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Overwrite the original in the game install"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock x:Name="OriginalPathText" Style="{StaticResource SmallText}"
                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <Border x:Name="OverwriteWarning" Grid.Row="2" Style="{StaticResource Card}"
                Padding="14,12" Margin="0,12,0,0"
                Background="{StaticResource WarningDim}"
                BorderBrush="{StaticResource Warning}"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Writing into the game install" Style="{StaticResource LabelText}"
                           Foreground="{StaticResource Warning}" />
                <TextBlock Style="{StaticResource SmallText}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="A timestamped backup is written first. Steam's file verification may flag modified files and restore them. Backups are never deleted automatically, so remove old ones yourself when you no longer need them." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource GhostButton}"
                    MinWidth="100" Click="OnCancel" IsCancel="True" />
            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}"
                    MinWidth="120" Margin="10,0,0,0" Click="OnSave" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
