<UserControl x:Class="ForzaCryptoTool.AssetBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True">

    <Grid Background="{StaticResource Bg}" Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Asset Browser" Style="{StaticResource TitleText}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="RootBox" Grid.Column="0" Style="{StaticResource Field}"
                     VerticalContentAlignment="Center"
                     ToolTip="Folder to browse" />

            <Button x:Name="BrowseButton" Grid.Column="1" Content="Change folder"
                    Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Click="OnBrowseClick" />

            <CheckBox x:Name="OnlyOpenable" Grid.Column="2" Style="{StaticResource Check}"
                      Content="Only openable" IsChecked="True" Margin="14,0,0,0"
                      VerticalAlignment="Center"
                      ToolTip="Hide entries that cannot be decrypted with the IVs currently available."
                      Checked="OnFilterChanged" Unchecked="OnFilterChanged" />

            <Button x:Name="ReloadButton" Grid.Column="3" Content="Reload"
                    Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                    Click="OnReloadClick" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="Tree" Grid.Column="0"
                      SelectedItemChanged="OnSelectionChanged"
                      TreeViewItem.Expanded="OnItemExpanded" />

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="DetailName" Style="{StaticResource HeadingText}"
                                       Text="Nothing selected" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DetailMeta" Style="{StaticResource SmallText}" Margin="0,4,0,0"
                                       Text="Select a file or archive entry to view it." TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="DirtyMarker" Text="edited"
                                       Foreground="{StaticResource Warning}"
                                       FontSize="{StaticResource FontTiny}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                       Visibility="Collapsed" />
                            <Button x:Name="RevertButton" Content="Revert"
                                    Style="{StaticResource GhostButton}" MinWidth="86"
                                    IsEnabled="False" Click="OnRevertClick" />
                            <Button x:Name="SaveButton" Content="Save"
                                    Style="{StaticResource PrimaryButton}" MinWidth="86"
                                    Margin="8,0,0,0" IsEnabled="False" Click="OnSaveClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="BlockerPanel" Grid.Row="1" Style="{StaticResource Card}"
                        Padding="14,12" Margin="0,0,0,10"
                        Background="{StaticResource WarningDim}"
                        BorderBrush="{StaticResource Warning}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="This entry is locked" Style="{StaticResource LabelText}"
                                   Foreground="{StaticResource Warning}" />
                        <TextBlock x:Name="BlockerText" Style="{StaticResource SmallText}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <TabControl x:Name="ContentTabs"
                                Background="{StaticResource Surface}" BorderThickness="0">
                        <TabItem Header="Text">
                            <TextBox x:Name="TextPane" Style="{StaticResource MonoField}"
                                     IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"
                                     TextChanged="OnTextChanged" />
                        </TabItem>
                        <TabItem Header="Hex">
                            <ContentControl x:Name="HexHost" />
                        </TabItem>
                    </TabControl>

                    <Border x:Name="EmptyState"
                            Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLarge}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="420" Margin="24">
                            <TextBlock x:Name="EmptyIcon" Text="&#x1F5DC;" FontSize="34"
                                       HorizontalAlignment="Center" Opacity="0.5" />
                            <TextBlock x:Name="EmptyTitle" Style="{StaticResource HeadingText}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"
                                       TextAlignment="Center" Text="Select a file to view it" />
                            <TextBlock x:Name="EmptyBody" Style="{StaticResource SecondaryText}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Text="Expand a folder or archive on the left, then choose a file." />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
