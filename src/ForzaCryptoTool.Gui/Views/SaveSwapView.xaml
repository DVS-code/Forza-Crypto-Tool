<UserControl x:Class="ForzaCryptoTool.SaveSwapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="28,24">
        <StackPanel MaxWidth="900">

            <TextBlock Text="Save Swap" Style="{StaticResource TitleText}" />
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,20"
                       Text="Put a donor save onto your account, keeping its progress." />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource AccentDim}" CornerRadius="12" Width="24" Height="24">
                            <TextBlock Text="1" Foreground="{StaticResource Accent}" FontWeight="Bold"
                                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Your save" Style="{StaticResource HeadingText}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <ListBox x:Name="SaveList" Margin="0,12,0,0" MaxHeight="220"
                             Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}"
                             BorderThickness="1" Foreground="{StaticResource TextPrimary}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnSaveSelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}" CornerRadius="6"
                                                    Margin="4,3">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Raised}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDim}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <TextBlock x:Name="NoSavesText" Style="{StaticResource SmallText}" Margin="0,12,0,0"
                               Foreground="{StaticResource Warning}" Visibility="Collapsed"
                               Text="No save found automatically. Use 'Choose manually' to point at your C_ProfileData." />

                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Rescan" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                                Click="OnRescanClick" />
                        <Button x:Name="IdentifyAccountsButton" Content="Identify accounts" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                                Click="OnIdentifyAccountsClick" ToolTip="Use the signed-in Xbox App session to label each save XUID with its gamertag" />
                        <Button Content="Choose manually" Style="{StaticResource GhostButton}"
                                Click="OnChooseTargetClick" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource AccentDim}" CornerRadius="12" Width="24" Height="24">
                            <TextBlock Text="2" Foreground="{StaticResource Accent}" FontWeight="Bold"
                                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Donor save" Style="{StaticResource HeadingText}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DonorBox" Grid.Column="0" Style="{StaticResource MonoField}"
                                 IsReadOnly="True" Text="" />
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0" Click="OnChooseDonorClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource AccentDim}" CornerRadius="12" Width="24" Height="24">
                            <TextBlock Text="3" Foreground="{StaticResource Accent}" FontWeight="Bold"
                                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Your account" Style="{StaticResource HeadingText}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="XuidHint" Style="{StaticResource SmallText}" Margin="0,8,0,0"
                               Text="Your XUID." />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="XuidBox" Grid.Column="0" Style="{StaticResource MonoField}"
                                 TextChanged="OnXuidChanged" />
                        <Button x:Name="GrabXuidButton" Grid.Column="1" Content="Detect"
                                Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                Click="OnGrabXuidClick"
                                ToolTip="Read your XUID from the running Xbox app (needs administrator)." />
                    </Grid>

                    <Border x:Name="RuneBanner" Background="{StaticResource InfoDim}"
                            BorderBrush="{StaticResource Info}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMedium}" Padding="12,10"
                            Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SmallText}" Foreground="{StaticResource Info}"
                                   Text="RUNE detected — XUID filled in automatically." />
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>

                    <TextBlock Style="{StaticResource SmallText}"
                               Text="Close Forza Horizon 6 before swapping, or it will save over the new file." />

                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="SwapButton" Content="Swap save" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,10,8" IsEnabled="False" Click="OnSwapClick" />

                        <Button x:Name="RestoreButton" Content="Restore original"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"
                                IsEnabled="False" Click="OnRestoreClick" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border x:Name="StepsCard" Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="StepsTitle" Style="{StaticResource HeadingText}" Text="Result" />
                    <TextBlock x:Name="StepsSummary" Style="{StaticResource SecondaryText}" Margin="0,6,0,10" />
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="StepList" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
