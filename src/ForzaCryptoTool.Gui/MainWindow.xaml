<Window x:Class="ForzaCryptoTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ForzaCryptoTool"
        Title="Forza Crypto Tool"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        Width="1120" Height="760"
        MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Height="30" Width="30"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Forza Crypto Tool" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource LabelText}"
                                   Text="Forza Horizon 6" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" x:Name="BackendPill" VerticalAlignment="Center"
                        Background="{StaticResource Overlay}" CornerRadius="{StaticResource RadiusMedium}"
                        Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="BackendDot" Width="8" Height="8" Fill="{StaticResource TextDisabled}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="BackendText" Text="Connecting…" Style="{StaticResource SmallText}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,16">
                    <StackPanel x:Name="NavPanel" DockPanel.Dock="Top" />

                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                        <TextBlock x:Name="VersionText" Style="{StaticResource LabelText}"
                                   Margin="12,0,0,6" Opacity="0.6" />
                    </StackPanel>

                    <Grid />
                </DockPanel>
            </Border>

            <ContentControl x:Name="ViewHost" Grid.Column="1" />
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource SmallText}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <ProgressBar x:Name="BusyBar" Grid.Column="1" Style="{StaticResource Bar}"
                             Width="140" IsIndeterminate="True" Visibility="Collapsed"
                             VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
